# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assets_management_dev

# Database URL for local development.
# Docker Compose overrides this with the db service hostname.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/assets_management_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Asset configuration
ASSET_TAG_COMPANY_PREFIX=IL

# Seed users
SEED_USER_PASSWORD=change-me
SEED_ADMIN_PASSWORD=change-me

# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-me
MAIL_FROM_EMAIL=your-email@example.com
MAIL_FROM_NAME=Assets Management API

# AWS / S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT_URL=http://localhost:4566
S3_PRESIGNED_URL_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=assets-management-files
S3_UPLOAD_CALLBACK_SECRET=replace-with-a-random-secret
